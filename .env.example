# Required: generate a private random token for communication between
# the platform backend, Audio API and Audio worker.
# Example: openssl rand -hex 32
AUDIO_SERVICE_TOKEN=replace-with-a-random-secret

# Container image pin for reproducible document extraction.
TIKA_IMAGE=apache/tika@sha256:b99f19c4fd76237dafe7d22f719b9bddfa9a449da687c597a41e2f6d9a595418

# Published host ports
BACKEND_PORT=8000
FRONTEND_PORT=8080
MLFLOW_PORT=5001
TIKA_PORT=9998

# Browser access
APP_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Upload limits
VIDEO_MAX_BYTES=209715200
AUDIO_MAX_UPLOAD_BYTES=20971520

# Video inference limits
VIDEO_MAX_DURATION_SECONDS=600
VIDEO_MAX_FRAMES=12
VIDEO_SAMPLE_INTERVAL_SECONDS=2
VIDEO_MEMORY_LIMIT=4g
VIDEO_CPU_QUOTA=2.0

# Audio inference configuration
AUDIO_MODEL_SOURCE=bundle
AUDIO_DECODE_TIMEOUT_SECONDS=30
AUDIO_INFERENCE_TIMEOUT_SECONDS=120
AUDIO_MAX_CONCURRENT_DECODE_JOBS=1
AUDIO_CHILD_CPU_LIMIT_SECONDS=25
AUDIO_CHILD_ADDRESS_SPACE_LIMIT_BYTES=
AUDIO_WORKER_MEMORY_LIMIT=1g
AUDIO_WORKER_CPU_QUOTA=1.0
